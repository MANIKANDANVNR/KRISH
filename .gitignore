# KRISH - Git Ignore

# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.iml

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Runtime / private data
data/
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary / backup files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Build / distribution
dist/
build/
*.egg-info/

# Local debug output
debug/

# Python tooling caches
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
